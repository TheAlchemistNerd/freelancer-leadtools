# ======================================================================
# Freelancer LeadTools - Environment Configuration
# ======================================================================
# Copy this file to .env and update values for your environment
# 
# Domain Configuration:
# - BASE_DOMAIN: Your primary domain (e.g., osfreelance.com)
# - Both .com and .io should route to the same backend via DNS/CDN
# - All emails will use @osfreelance.com domain
# ======================================================================

# ----------------------------------------------------------------------
# Domain Configuration
# ----------------------------------------------------------------------
# Primary domain - used for generating URLs and emails
# Both osfreelance.com and osfreelance.io should point to this
BASE_DOMAIN=osfreelance.com

# Subdomain configuration
LEADTOOLS_SUBDOMAIN=api.freelancerleadtools
GROWTH_SUBDOMAIN=api.freelancegrowth
DEALFLOW_SUBDOMAIN=api.freelancedealflow

# Frontend subdomains (for CTAs)
GROWTH_FRONTEND_SUBDOMAIN=app.freelancegrowth
DEALFLOW_FRONTEND_SUBDOMAIN=app.freelancedealflow

# ----------------------------------------------------------------------
# Email Configuration - SendGrid (Recommended for Production)
# ----------------------------------------------------------------------
# SendGrid: https://sendgrid.com (Free: 100/day, Paid: from $19.95/mo)
# Alternatives: Postmark, Amazon SES, Mailgun, Resend

# Email provider: sendgrid, postmark, ses, mailgun, smtp
EMAIL_PROVIDER=sendgrid

# SendGrid API Key (create at https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid Sender Address (must be verified in SendGrid)
EMAIL_FROM=noreply@leadtools.osfreelance.com
EMAIL_FROM_NAME=Freelancer LeadTools
EMAIL_SUPPORT=support@osfreelance.com
EMAIL_BILLING=billing@osfreelance.com

# Fallback SMTP (only if EMAIL_PROVIDER=smtp)
# For SendGrid SMTP: use 'apikey' as username and your API key as password
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
SMTP_USE_TLS=true
SMTP_TIMEOUT=30
SMTP_MAX_RETRIES=3

# ----------------------------------------------------------------------
# Redis Configuration (REQUIRED for rate limiting and lead storage)
# ----------------------------------------------------------------------
# Redis is used for:
# - Rate limiting (sliding window)
# - Lead storage (with TTL eviction)
# - Session management
# - Analytics counters
# - CRM sync queue

# Local development
REDIS_URL=redis://localhost:6379/0

# Production (Upstash for Vercel/serverless)
# REDIS_URL=redis://default:password@host:port

# Rate limiting configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WHITELIST=127.0.0.1,10.0.0.1  # Comma-separated IPs to bypass

# ----------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------
# Secret key for CSRF token generation and session signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-min-32-chars

# Bot protection
BOT_PROTECTION_ENABLED=true
# Block these User-Agent patterns (comma-separated)
# BOT_BLOCK_PATTERNS=scraper,scrapy,wget

# Request size limits (bytes)
MAX_BODY_SIZE=1048576  # 1 MB
MAX_URL_LENGTH=2048  # 2 KB

# ----------------------------------------------------------------------
# Lead Storage Configuration
# ----------------------------------------------------------------------
# How long to store leads in Redis before eviction (seconds)
LEAD_TTL_SECONDS=604800  # 7 days

# Deduplication window - prevent same email submitting multiple times (seconds)
LEAD_DEDUPE_TTL_SECONDS=86400  # 24 hours

# CRM sync configuration
CRM_SYNC_ENABLED=true
CRM_SYNC_BATCH_SIZE=10

# ----------------------------------------------------------------------
# Product URLs (CTA Destinations) - Auto-generated from domain config
# ----------------------------------------------------------------------
# These are constructed as: https://{subdomain}.{base_domain}
# Example: https://app.freelancegrowth.osfreelance.com/signup

# Individual Freelancer Product
FREELANCE_GROWTH_URL=https://${GROWTH_FRONTEND_SUBDOMAIN}.${BASE_DOMAIN}
FREELANCE_GROWTH_SIGNUP=/signup

# Agency Product
FREELANCER_DEALFLOW_URL=https://${DEALFLOW_FRONTEND_SUBDOMAIN}.${BASE_DOMAIN}
FREELANCER_DEALFLOW_SIGNUP=/signup

# ----------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------
APP_NAME=Freelancer LeadTools
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development  # development, staging, production

# ----------------------------------------------------------------------
# Server Settings
# ----------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=true  # Set to true for local development

# ----------------------------------------------------------------------
# Lead Capture Settings
# ----------------------------------------------------------------------
# Configure where captured leads are sent

ENABLE_LEAD_CAPTURE=true
LEAD_CAPTURE_PROVIDER=convertkit  # convertkit, mailchimp, custom

# ConvertKit (for email capture)
CONVERTKIT_API_KEY=your_convertkit_api_key
CONVERTKIT_FORM_ID=your_form_id

# Mailchimp (alternative)
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_AUDIENCE_ID=your_audience_id

# ----------------------------------------------------------------------
# Analytics Settings
# ----------------------------------------------------------------------
# Configure analytics provider

ANALYTICS_PROVIDER=plausible  # plausible, google, umami
ENABLE_ANALYTICS=true

# Plausible Analytics (privacy-focused)
PLAUSIBLE_DOMAIN=leadtools.osfreelance.com

# Google Analytics (alternative)
GOOGLE_ANALYTICS_ID=

# Umami Analytics (self-hosted alternative)
UMAMI_WEBSITE_ID=

# ----------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100  # requests per minute per IP
RATE_LIMIT_ENABLED=true

# ----------------------------------------------------------------------
# CORS Settings
# ----------------------------------------------------------------------
# For production, specify exact origins
# Both .com and .io should be allowed
CORS_ALLOW_ORIGINS=[
    "https://freelancerleadtools.osfreelance.com",
    "https://freelancerleadtools.osfreelance.io",
    "https://api.freelancerleadtools.osfreelance.com",
    "https://api.freelancerleadtools.osfreelance.io",
    "https://app.freelancegrowth.osfreelance.com",
    "https://app.freelancegrowth.osfreelance.io",
    "https://app.freelancedealflow.osfreelance.com",
    "https://app.freelancedealflow.osfreelance.io",
]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ----------------------------------------------------------------------
# Logging Settings
# ----------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text

# ----------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------
API_KEY_HEADER=X-API-Key
# Comma-separated list of API keys for protected endpoints
API_KEYS=

# ----------------------------------------------------------------------
# Database (Optional - for persistent lead storage)
# ----------------------------------------------------------------------
# Leave empty for in-memory storage (good for development)
# For production, use: postgresql://user:pass@host:5432/leadtools
DATABASE_URL=

# ----------------------------------------------------------------------
# Cache Settings (Redis - Optional)
# ----------------------------------------------------------------------
# Leave empty for no caching
# For production, use: redis://localhost:6379/0
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ----------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------
# Enable/disable individual calculators
ENABLE_BURNOUT_CALCULATOR=true
ENABLE_SKILL_GAP_CALCULATOR=true
ENABLE_PORTFOLIO_CALCULATOR=true
ENABLE_CLIENT_FIT_CALCULATOR=true
ENABLE_SCOPE_CREEP_CALCULATOR=true
ENABLE_HOURLY_RATE_CALCULATOR=true
ENABLE_FREELANCE_VS_FULLTIME_CALCULATOR=true
ENABLE_AGENCY_PROFIT_CALCULATOR=true
ENABLE_UTILIZATION_CALCULATOR=true
ENABLE_CLIENT_LTV_CALCULATOR=true
ENABLE_PROPOSAL_WIN_RATE_CALCULATOR=true
ENABLE_CASH_FLOW_CALCULATOR=true
ENABLE_BREAK_EVEN_CALCULATOR=true
ENABLE_RATE_PPP_CALCULATOR=true
ENABLE_TAX_ESTIMATOR_CALCULATOR=true
ENABLE_RETIREMENT_CALCULATOR=true
ENABLE_TIME_VALUE_CALCULATOR=true
